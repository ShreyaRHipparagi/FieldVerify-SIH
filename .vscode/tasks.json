{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run FieldVerify Web App",
            "type": "shell",
            "command": "python",
            "args": [
                "run_app.py"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Automated Tests (Pytest)",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "pytest",
                "tests/test_fieldverify.py",
                "-v"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
